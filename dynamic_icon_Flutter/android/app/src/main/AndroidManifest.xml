<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="icon_change_test"
        android:name="${applicationName}"
        android:icon="@mipmap/mydefaulticon"
        android:enabled="true">
            
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:enabled="false"
            android:exported="true">
            
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Default Icon -->
        <activity-alias
            android:icon="@mipmap/mydefaulticon"
            android:roundIcon="@mipmap/mydefaulticon"
            android:name="appicon.DefaultIcon"
            android:exported="true"
            android:enabled="true"
            android:targetActivity=".MainActivity">
            
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Blue Icon -->
        <activity-alias
            android:icon="@mipmap/myblueicon"
            android:roundIcon="@mipmap/myblueicon"
            android:name="appicon.BlueIcon"
            android:exported="true"
            android:enabled="false"
            android:targetActivity=".MainActivity">
            
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Yellow Icon -->
        <activity-alias
            android:icon="@mipmap/myyellowicon"
            android:roundIcon="@mipmap/myyellowicon"
            android:name="appicon.YellowIcon"
            android:exported="true"
            android:enabled="false"
            android:targetActivity=".MainActivity">
            
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Red Icon -->
        <activity-alias
            android:icon="@mipmap/myredicon"
            android:roundIcon="@mipmap/myredicon"
            android:name="appicon.RedIcon"
            android:exported="true"
            android:enabled="false"
            android:targetActivity=".MainActivity">
            
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>